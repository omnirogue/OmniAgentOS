<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>{{LABEL}}</string>
    <key>ProgramArguments</key>
    {{PROGRAM_ARGS}}
    <key>WorkingDirectory</key><string>{{WORKING_DIR}}</string>
    <key>StartInterval</key><integer>900</integer>
    <key>StandardOutPath</key><string>{{WORKING_DIR}}/var/log/steward-alerts.log</string>
    <key>StandardErrorPath</key><string>{{WORKING_DIR}}/var/log/steward-alerts.log</string>
</dict>
</plist>
