<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>{{LABEL}}</string>
    <key>ProgramArguments</key>
    {{PROGRAM_ARGS}}
    <key>WorkingDirectory</key><string>{{WORKING_DIR}}</string>
    <!-- Daily cache/derived-data GC. Machine TZ is America/New_York, so the
         default Hour 3 fires at 3 AM Eastern — after the 2 AM banking snapshot and
         the hourly revenue collectors, so the just-written caches are never
         trimmed mid-collection. -->
    <key>StartCalendarInterval</key>
    <dict><key>Hour</key><integer>{{HOUR}}</integer><key>Minute</key><integer>{{MINUTE}}</integer></dict>
    <key>StandardOutPath</key><string>/tmp/{{LABEL}}.out.log</string>
    <key>StandardErrorPath</key><string>/tmp/{{LABEL}}.err.log</string>
</dict>
</plist>
