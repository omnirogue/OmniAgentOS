{
  "mcpServers": {
    "fetch": {
      "command": "uvx",
      "args": [
        "--python",
        "3.12",
        "--with",
        "mcp<2",
        "mcp-server-fetch"
      ]
    },
    "memory": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ]
    },
    "sqlite": {
      "command": "uvx",
      "args": [
        "--python",
        "3.12",
        "--with",
        "mcp<2",
        "mcp-server-sqlite",
        "--db-path",
        "tools/state/sqlite-mcp.db"
      ]
    },
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/Users/youruser/OmniAgentOS"
      ]
    },
    "git": {
      "command": "uvx",
      "args": [
        "--python",
        "3.12",
        "--with",
        "mcp<2",
        "mcp-server-git"
      ]
    }
  }
}
