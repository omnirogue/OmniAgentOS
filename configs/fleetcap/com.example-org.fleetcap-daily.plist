<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.example-org.fleetcap-daily</string>
  <key>ProgramArguments</key><array>
    <string>/Users/youruser/OmniAgentOS/.venv/bin/python</string>
    <string>-m</string><string>omniagentos.fleetcap.daily</string>
    <string>--output-dir</string><string>/Users/youruser/Work/Ops/telemetry/briefs</string>
    <string>--config</string><string>/Users/youruser/OmniAgentOS/configs/fleetcap/devices.yaml</string>
    <string>--reflection-root</string><string>/Users/youruser/OmniAgentOS/var/reflection</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/youruser/Work/Ops/telemetry</string>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>12</integer></dict>
  <key>Nice</key><integer>10</integer><key>LowPriorityIO</key><true/>
  <key>StandardOutPath</key><string>/Users/youruser/Work/Ops/telemetry/logs/fleetcap-daily.log</string>
  <key>StandardErrorPath</key><string>/Users/youruser/Work/Ops/telemetry/logs/fleetcap-daily.err.log</string>
</dict></plist>
