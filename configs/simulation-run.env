# Simulation run — full-capacity flag set
# Source this before launching. Every value is a deliberate choice; the OFF
# entries at the bottom matter as much as the ON ones.
#
#   set -a; . configs/simulation-run.env; set +a
#
# Written 2026-07-27 for the first self-optimizing run.

# --- Isolation (non-negotiable for an unattended run) ----------------------
# Lane 1 built this: without it a "simulation" inherits the operator DB,
# ledger, vault and var dir and silently mutates production state.
export OMNIAGENTOS_SIM_MODE=1
export OMNIAGENTOS_SIM_CAMPAIGN=selfopt-001
export OMNIAGENTOS_SWARM_EXECUTE=1
export OMNIAGENTOS_SWARM_WORKTREES=enforce

# --- Budget (non-negotiable for an unattended run) -------------------------
# The acceptance suite found the SHIPPED DEFAULT blocks nothing: cost gating is
# opt-in via this flag, and omitted BudgetSpec dimensions default to unbounded.
# Unattended + unbounded is how a night turns into a bill.
export OMNIAGENTOS_BUDGET_ENFORCEMENT=block

# --- The point of the run: worker context at full strength -----------------
export OMNIAGENTOS_ROLE_PACK_MODE=enforce        # role contracts finally reach workers (R2)
export OMNIAGENTOS_CORAL_CONTEXT_MODE=enforce    # skill/playbook CONTENT, not name@version (N6)
export OMNIAGENTOS_PROJECT_CONTRACT_MODE=enforce # per-project brand + MEMORY content (F3)
export OMNIAGENTOS_CHAMPION_PROMPT_MODE=enforce  # promoted champions reach spawn (N1)
export OMNIAGENTOS_CHAMPION_ROUTING_MODE=enforce # champion rows read by cbm/routing (N2)

# --- Verification at full strength -----------------------------------------
export OMNIAGENTOS_VERIFY_GATE=enforce           # py_compile gate before the reviewer (F3)
export OMNIAGENTOS_CASCADE=1                     # gemini x2 -> grok-4.5 -> sol -> fable
export OMNIAGENTOS_LAB_VALIDITY_MODE=enforce     # agreement/validity floors gate promotion
export OMNIAGENTOS_METHODOLOGY_REVIEW_MODE=enforce
export OMNIAGENTOS_SCOPE_LOCKS=enforce           # writes outside declared scope are blocked

# --- Observation ------------------------------------------------------------
# NOT a boolean — routing/cascade.py:52 treats this as a PATH OVERRIDE, so '=1'
# silently writes every trace to a file literally named '1' in the process cwd,
# and routing.learn.read_traces then looks in the default location and finds
# nothing. Found by the selfopt-001 run (O-3): the one flag added to make the
# run observable was the one that silently wasn't. Unset = correct default.
# export OMNIAGENTOS_CASCADE_TRACE=<path>   # only if redirecting traces
export OMNIAGENTOS_SESSION_MEMORY_CAPTURE_MODE=shadow

# ===========================================================================
# DELIBERATELY NOT ENABLED — each of these would be a lie or a bypass
# ===========================================================================
#
# OMNIAGENTOS_IMPROVE_MODE=on
#   By design this needs the flag AND a human `approved_by` row (the
#   two-artifact rule). Flipping it from an agent would defeat the control it
#   exists to provide. Left at shadow: the machinery runs, merges land on
#   shadow-main, nothing touches main unattended.
export OMNIAGENTOS_IMPROVE_MODE=shadow
#
# OMNIAGENTOS_ALLOWED_PROVIDERS_MODE=enforce
#   Lane D's review found the planner half is capability-only — no production
#   caller passes allowed_providers, and dispatch/gate.py:736 hard-pins a
#   Claude CLI. Enforcing would ASSERT an invariant the code cannot honour.
#   Off until that is threaded.
#
# OMNIAGENTOS_TASK_SHAPE_FANOUT_MODE=enforce / OMNIAGENTOS_CREATIVE_TOPOLOGY_MODE=enforce
#   Both are gated on shadow evidence by an explicit standing decision
#   ("more agents != better"). Shadow collects the rows that would justify a
#   flip; enforcing now would pre-empt the very measurement.
export OMNIAGENTOS_TASK_SHAPE_FANOUT_MODE=shadow
export OMNIAGENTOS_CREATIVE_TOPOLOGY_MODE=shadow
#
# OMNIAGENTOS_QUICK_PROJECT_ROUTING_MODE=enforce
#   The Opus post-merge review named two hard blockers before any enforce
#   flip: shadow mode writes preflight_json that spawn.py consumes into worker
#   prompts (so shadow is not passive), and the clarify response is dropped by
#   the only client (brief lost, no card created). Shadow until both are fixed.
export OMNIAGENTOS_QUICK_PROJECT_ROUTING_MODE=shadow
