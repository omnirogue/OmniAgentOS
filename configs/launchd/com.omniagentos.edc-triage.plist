<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  EDC triage runs every 330 seconds, deliberately dephased from the mail poller's
  300-second interval so fresh ingests normally arrive before the next triage pass.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.omniagentos.edc-triage</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>-lc</string>
        <string>set -a; . "$HOME/.config/omni/connections.env" 2&gt;/dev/null; set +a; . /Users/youruser/OmniAgentOS/scripts/launch-env.sh; exec /Users/youruser/OmniAgentOS/.venv/bin/python -m omniagentos.edc.main</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/youruser/OmniAgentOS</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>OMNIAGENTOS_DB</key>
        <string>/Users/youruser/OmniAgentOS/var/runtime/state.sqlite3</string>
        <key>OMNIAGENTOS_LEDGER_DIR</key>
        <string>/Users/youruser/OmniAgentOS/var/runtime/ledger</string>
        <key>OMNIAGENTOS_VAR</key>
        <string>/Users/youruser/OmniAgentOS/var/runtime</string>
        <key>OMNIAGENTOS_VAR_DIR</key>
        <string>/Users/youruser/OmniAgentOS/var/runtime</string>
        <key>OMNIAGENTOS_VAULT_DIR</key>
        <string>/Users/youruser/OmniAgentOS/var/runtime/vault</string>
        <key>PATH</key>
        <string>/Users/youruser/.local/bin:/Users/youruser/.grok/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>StartInterval</key>
    <integer>330</integer>
    <key>RunAtLoad</key>
    <false/>
    <key>KeepAlive</key>
    <false/>
    <key>StandardOutPath</key>
    <string>/Users/youruser/OmniAgentOS/var/log/edc-triage.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/youruser/OmniAgentOS/var/log/edc-triage.log</string>
</dict>
</plist>
