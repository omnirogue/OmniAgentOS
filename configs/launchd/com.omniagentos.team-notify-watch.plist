<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Separate job: launchd has one ProgramArguments vector per job, while this
     invocation must run the watch-once flag rather than the morning mode flag. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.omniagentos.team-notify-watch</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
		<key>OMNIAGENTOS_DB</key>
		<string>/Users/youruser/OmniAgentOS/var/runtime/state.sqlite3</string>
	</dict>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/youruser/OmniAgentOS/.venv/bin/python</string>
		<string>-m</string>
		<string>omniagentos.team.notify</string>
		<string>--watch-once</string>
		<string>--db</string>
		<string>/Users/youruser/OmniAgentOS/var/runtime/state.sqlite3</string>
	</array>
	<key>WorkingDirectory</key>
	<string>/Users/youruser/OmniAgentOS</string>
	<key>StartInterval</key>
	<integer>300</integer>
	<key>RunAtLoad</key>
	<false/>
	<key>KeepAlive</key>
	<false/>
	<key>StandardOutPath</key>
	<string>/Users/youruser/OmniAgentOS/var/log/team-notify-watch.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/youruser/OmniAgentOS/var/log/team-notify-watch.log</string>
</dict>
</plist>
