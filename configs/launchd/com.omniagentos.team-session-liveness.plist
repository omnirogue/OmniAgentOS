<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.omniagentos.team-session-liveness</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/youruser/OmniAgentOS/.venv/bin/python</string>
        <string>-m</string>
        <string>omniagentos.team.session_liveness</string>
        <string>--collect-local</string>
        <string>emp_owner</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/youruser/OmniAgentOS</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin</string>
        <key>OMNIAGENTOS_DB</key>
        <string>/Users/youruser/OmniAgentOS/var/runtime/state.sqlite3</string>
    </dict>
    <key>StartInterval</key>
    <integer>600</integer>
    <key>RunAtLoad</key>
    <false/>
    <key>KeepAlive</key>
    <false/>
    <key>StandardOutPath</key>
    <string>/Users/youruser/OmniAgentOS/var/log/team-session-liveness.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/youruser/OmniAgentOS/var/log/team-session-liveness.log</string>
</dict>
</plist>
