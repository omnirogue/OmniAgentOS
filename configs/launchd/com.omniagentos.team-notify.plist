<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Morning queue DMs. Event watching has distinct ProgramArguments, so it is
     deliberately installed as com.omniagentos.team-notify-watch.plist. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.omniagentos.team-notify</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
		<key>OMNIAGENTOS_DB</key>
		<string>/Users/youruser/OmniAgentOS/var/runtime/state.sqlite3</string>
	</dict>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/youruser/OmniAgentOS/.venv/bin/python</string>
		<string>-m</string>
		<string>omniagentos.team.notify</string>
		<string>--morning</string>
		<string>--db</string>
		<string>/Users/youruser/OmniAgentOS/var/runtime/state.sqlite3</string>
	</array>
	<key>WorkingDirectory</key>
	<string>/Users/youruser/OmniAgentOS</string>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>6</integer>
		<key>Minute</key>
		<integer>55</integer>
	</dict>
	<key>RunAtLoad</key>
	<false/>
	<key>KeepAlive</key>
	<false/>
	<key>StandardOutPath</key>
	<string>/Users/youruser/OmniAgentOS/var/log/team-notify.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/youruser/OmniAgentOS/var/log/team-notify.log</string>
</dict>
</plist>
